{
  "$schema": "https://vercel.sh",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "buildCommand": "echo 'Pas de build nécessaire pour le backend'"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}





