NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/schoolbooks_db
CLIENT_URL=http://localhost:5173
# Dossier des PDF du catalogue (relatif à apps/api), hors Git.
# Les PDF envoyés par les formateurs sont rangés dans STORAGE_DIR/uploads/books.
STORAGE_DIR=storage
# Secrets de signature des jetons (obligatoires en production, longues chaînes aléatoires) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durées de vie en secondes (défaut : 900 = 15 min, 604800 = 7 jours).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# SameSite des cookies de session : lax (frontend derrière le proxy /api, recommandé)
# ou none (frontend sur un autre domaine qui appelle l'API directement ; HTTPS obligatoire,
# et CLIENT_URL doit contenir l'URL du frontend).
COOKIE_SAMESITE=lax
