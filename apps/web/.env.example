# Variables du frontend (copier en apps/web/.env.local, jamais versionné).

# true = le frontend utilise les données fictives de @schoolbooks/shared/mocks,
# sans appeler le backend. Utile pour avancer sur une page sans API démarrée.
VITE_USE_MOCKS=false

# Backend vers lequel Vite relaie /api en développement.
VITE_API_PROXY_TARGET=http://localhost:3000

# URL de base de l'API vue par le navigateur. Laisser vide en développement
# (utilise /api via le proxy). À renseigner en production si l'API est ailleurs.
VITE_API_URL=
